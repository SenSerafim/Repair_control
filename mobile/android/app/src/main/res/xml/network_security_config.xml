<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext (HTTP) traffic to all destinations.
  Reason: staging API живёт на голом IP 193.181.209.219:80 без TLS.
  Android 9+ (API 28+) по умолчанию блокирует cleartext, и поведение
  <domain> с IP-литералами не везде стабильно — на части физ.девайсов
  (особенно с MIUI / EMUI / OneUI кастомным DPI) запрос молча падает.
  base-config c cleartextTrafficPermitted="true" — единственный 100%
  способ гарантировать, что HTTP уйдёт с устройства. Когда поднимем
  HTTPS-домен, тут можно сузить через <domain-config>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
