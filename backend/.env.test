NODE_ENV=test
PORT=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repair_control_test?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=test_access_secret_min_16_chars_long
JWT_REFRESH_SECRET=test_refresh_secret_min_16_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

BCRYPT_COST=4

SMS_PROVIDER=stub
SMS_STUB_CODE=123456

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=repair-control-test
MINIO_PRESIGN_TTL_SECONDS=300
MINIO_REGION=us-east-1
MINIO_PATH_STYLE=true

FILE_MAX_SIZE_MB=25
FILE_ALLOWED_MIMES=image/jpeg,image/png,application/pdf

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_BLOCK_SECONDS=300

RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BLOCK_SECONDS=300

# S5 test-defaults: наблюдаемость в silent, push выключен, admin URL — заглушка
SENTRY_DSN=
LOG_LEVEL=warn
LOG_PRETTY=false
METRICS_TOKEN=test_metrics

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

EXPORT_TEMP_DIR=/tmp/repair-control-exports-test
PDF_LOGO_URL=
ZIP_MAX_SIZE_MB=100

SUPPORT_TELEGRAM_URL=https://t.me/test

WS_CORS_ORIGIN=*
WS_PING_INTERVAL_MS=25000
WS_PING_TIMEOUT_MS=20000
