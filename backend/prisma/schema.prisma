// ---------- S5 Enums ----------

enum ChatType {
  project
  stage
  personal
  group
}

enum DocumentCategory {
  contract
  act
  estimate
  warranty
  photo
  blueprint
  other
}

enum NotificationKind {
  // --- CRITICAL (не отключается пользователем) ---
  approval_requested
  approval_approved
  approval_rejected
  payment_created
  stage_rejected_by_customer
  stage_overdue
  stage_deadline_exceeds_project
  material_request_created
  material_delivered
  material_disputed
  selfpurchase_created
  tool_issued
  export_completed
  export_failed
  // --- HIGH (отключается) ---
  chat_message_new
  step_completed
  stage_completed
  stage_paused
  note_created_for_me
  question_asked
  // --- NORMAL / system ---
  project_archived
  membership_added
  admin_announcement
  // --- S+ (added 2026-05-04) ---
  stage_foreman_assigned
  stage_master_assigned
  stage_create_requested
  material_purchase_requested
  budget_changed
  tool_request_created
  tool_request_decided
  tool_custody_changed
  // --- E1a — заявки 2.0 (2026-05-27) ---
  material_request_accepted_partial
  material_request_accepted_full
  material_request_overdue
}

enum NotificationPriority {
  critical
  high
  normal
}

enum ExportKind {
  feed_pdf
  project_zip
  project_summary_txt // deprecated — TXT-сводка больше не предлагается, оставлено для совместимости
  project_report_pdf
  stage_report_pdf
}

enum ExportStatus {
  queued
  running
  done
  failed
  expired
}

// ---------- Users / Auth ----------

model User {
  id           String     @id @default(cuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  language     String     @default("ru")
  activeRole   SystemRole @default(customer)
  lastSeenAt   DateTime?
  bannedAt     DateTime?
  banReason    String?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles            UserRole[]
  sessions         Session[]
  devices          DeviceToken[]
  recoveryAttempts RecoveryAttempt[]
  loginAttempts    LoginAttempt[]
  legalAcceptances LegalAcceptance[]

  ownedProjects   Project[]           @relation("ProjectOwner")
  memberships     Membership[]
  invitationsSent ProjectInvitation[] @relation("InvitationInvitedBy")
  subscriptions   Subscription[]
  assignedTools   ToolItem[]          @relation("ToolAssignedEmployee")

  @@index([deletedAt])
}

model UserRole {
  userId   String
  role     SystemRole
  isActive Boolean    @default(true)
  addedAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  deviceId         String
  userAgent        String?
  ipFingerprint    String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  platform   DevicePlatform
  token      String         @unique
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model RecoveryAttempt {
  id           String    @id @default(cuid())
  userId       String
  code         String
  attempts     Int       @default(0)
  isUsed       Boolean   @default(false)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Projects ----------

model Project {
  id                   String        @id @default(cuid())
  ownerId              String
  title                String
  address              String?
  description          String?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  status               ProjectStatus @default(active)
  workBudget           BigInt        @default(0) // minor units (копейки)
  materialsBudget      BigInt        @default(0)
  progressCache        Int           @default(0)
  semaphoreCache       String        @default("green")
  planApproved         Boolean       @default(false)
  requiresPlanApproval Boolean       @default(false)
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  owner            User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  memberships      Membership[]
  invitations      ProjectInvitation[]
  stages           Stage[]
  feedEvents       FeedEvent[]
  approvals        Approval[]
  payments         Payment[]
  materialRequests MaterialRequest[]
  selfPurchases    SelfPurchase[]
  expenses         Expense[]
  chats            Chat[]
  documents        Document[]
  exportJobs       ExportJob[]

  @@index([ownerId])
  @@index([status])
}

model Membership {
  id            String         @id @default(cuid())
  projectId     String
  userId        String
  role          MembershipRole
  invitedById   String?
  stageIds      String[]       @default([])
  permissions   Json           @default("{}")
  /// Soft-removal: участник вышел из команды или был удалён.
  /// Все запросы фильтруются по removedAt IS NULL (см. P7.2).
  removedAt     DateTime?
  removedById   String?
  /// Персональный hide-флаг — проект скрыт у этого пользователя без выхода.
  hiddenForUser Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
  @@index([removedAt])
}

model ProjectInvitation {
  id          String           @id @default(cuid())
  projectId   String
  /// Для phone-flow (S2). Для invite-by-code (P2) — пустая строка.
  phone       String           @default("")
  role        MembershipRole
  invitedById String
  status      InvitationStatus @default(pending)
  /// 6-значный код приглашения (P2) или random-token для phone-flow (S2). Уникальный.
  token       String           @unique
  /// Делегированные права при акцепте (для роли representative).
  permissions Json?
  /// Если приглашают на конкретные этапы — список Stage.id.
  stageIds    String[]         @default([])
  acceptedBy  String?
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([projectId])
  @@index([phone])
  @@index([token, status])
}

// ---------- Stages ----------

model Stage {
  id              String      @id @default(cuid())
  projectId       String
  title           String
  orderIndex      Int
  status          StageStatus @default(pending)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  originalEnd     DateTime?
  pauseDurationMs BigInt      @default(0)
  workBudget      BigInt      @default(0)
  materialsBudget BigInt      @default(0)
  /// Бригадиры этапа. По решению заказчика (П1.11) — один бригадир на этап,
  /// массив сохранён для обратной совместимости и групповых сценариев.
  foremanIds      String[]    @default([])
  /// Назначенный мастер на этап (один). Если null — этап ведёт сам бригадир (П2.5/П2.6).
  masterId        String?
  /// Если true — этап создан бригадиром и ожидает согласования заказчика (П2.4).
  /// До approve все step.* действия заблокированы.
  pendingApproval Boolean     @default(false)
  progressCache   Int         @default(0)
  planApproved    Boolean     @default(false)
  startedAt       DateTime?
  sentToReviewAt  DateTime?
  doneAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pauses           Pause[]
  steps            Step[]
  approvals        Approval[]
  payments         Payment[]
  materialRequests MaterialRequest[]
  selfPurchases    SelfPurchase[]
  expenses         Expense[]
  chats            Chat[]

  @@index([projectId, orderIndex])
  @@index([status])
}

model Pause {
  id        String      @id @default(cuid())
  stageId   String
  reason    PauseReason
  comment   String?
  startedAt DateTime    @default(now())
  endedAt   DateTime?
  startedBy String

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

// ---------- Templates ----------

model Template {
  id          String       @id @default(cuid())
  kind        TemplateKind
  authorId    String?
  title       String
  description String?
  payload     Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  steps TemplateStep[]

  @@index([kind])
}

model TemplateStep {
  id         String  @id @default(cuid())
  templateId String
  title      String
  orderIndex Int
  price      BigInt?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, orderIndex])
}

// ---------- Steps / Substeps / Photos ----------

model Step {
  id                   String     @id @default(cuid())
  stageId              String
  title                String
  orderIndex           Int
  type                 StepType   @default(regular)
  status               StepStatus @default(pending)
  price                BigInt?
  description          String?
  /// Отчёт мастера/бригадира при закрытии шага (П2.8): «что делал».
  whatDid              String?
  /// Отчёт мастера/бригадира при закрытии шага (П2.8): «как делал».
  howDid               String?
  authorId             String
  assigneeIds          String[]   @default([])
  methodologyArticleId String?
  doneAt               DateTime?
  doneById             String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  stage              Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)
  methodologyArticle MethodologyArticle? @relation(fields: [methodologyArticleId], references: [id], onDelete: SetNull)
  substeps           Substep[]
  photos             StepPhoto[]
  questions          Question[]
  approvals          Approval[]

  @@index([stageId, orderIndex])
  @@index([status])
  @@index([type])
  @@index([methodologyArticleId])
}

model Substep {
  id        String    @id @default(cuid())
  stepId    String
  text      String
  authorId  String
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([authorId])
}

model StepPhoto {
  id          String   @id @default(cuid())
  stepId      String
  fileKey     String
  thumbKey    String?
  mimeType    String
  sizeBytes   Int
  uploadedBy  String
  exifCleared Boolean  @default(false)
  createdAt   DateTime @default(now())

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

// ---------- Notes / Questions ----------

model Note {
  id                 String            @id @default(cuid())
  scope              NoteScope
  authorId           String
  addresseeId        String?
  projectId          String?
  stageId            String?
  text               String?
  kind               NoteKind          @default(text)
  audioKey           String?
  audioMimeType      String?
  audioDurationMs    Int?
  transcript         String?
  transcriptStatus   TranscriptStatus?
  transcriptProvider String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([authorId, scope, createdAt])
  @@index([addresseeId, scope])
  @@index([stageId])
  @@index([projectId])
  @@index([kind])
}

model Question {
  id          String         @id @default(cuid())
  stepId      String
  authorId    String
  addresseeId String
  text        String
  status      QuestionStatus @default(open)
  answer      String?
  answeredAt  DateTime?
  answeredBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, status])
  @@index([addresseeId, status])
}

// ---------- Approvals ----------

model Approval {
  id               String          @id @default(cuid())
  scope            ApprovalScope
  projectId        String
  stageId          String?
  stepId           String?
  payload          Json            @default("{}")
  requestedById    String
  addresseeId      String
  /// Роль адресата (П2.6): для двухступенчатого stage_accept здесь хранится
  /// foreman или customer — в зависимости от того, какая ступень активна.
  /// Используется в UI для выбора отображения CTA «Принять/Отклонить» (П2.7).
  actorRole        MembershipRole?
  status           ApprovalStatus  @default(pending)
  attemptNumber    Int             @default(1)
  requiresReassign Boolean         @default(false)
  decidedAt        DateTime?
  decidedById      String?
  decisionComment  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       Stage?               @relation(fields: [stageId], references: [id], onDelete: Cascade)
  step        Step?                @relation(fields: [stepId], references: [id], onDelete: Cascade)
  attempts    ApprovalAttempt[]
  attachments ApprovalAttachment[]

  @@index([projectId, status])
  @@index([addresseeId, status])
  @@index([stageId])
  @@index([stepId])
  @@index([scope, status])
}

model ApprovalAttempt {
  id            String   @id @default(cuid())
  approvalId    String
  attemptNumber Int
  action        String
  actorId       String
  comment       String?
  createdAt     DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId, createdAt])
}

model ApprovalAttachment {
  id         String   @id @default(cuid())
  approvalId String
  fileKey    String
  thumbKey   String?
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  createdAt  DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
}

// ---------- Methodology ----------

model MethodologySection {
  id         String   @id @default(cuid())
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  articles MethodologyArticle[]

  @@index([orderIndex])
}

model MethodologyArticle {
  id         String   @id @default(cuid())
  sectionId  String
  title      String
  body       String
  orderIndex Int
  version    Int      @default(1)
  etag       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section         MethodologySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  referencePhotos ReferencePhoto[]
  steps           Step[]

  @@index([sectionId, orderIndex])
}

model ReferencePhoto {
  id         String  @id @default(cuid())
  articleId  String
  fileKey    String
  caption    String?
  orderIndex Int

  article MethodologyArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, orderIndex])
}

// ---------- Payments ----------

model Payment {
  id              String      @id @default(cuid())
  projectId       String
  stageId         String?
  parentPaymentId String?
  kind            PaymentKind
  fromUserId      String
  toUserId        String
  amount          BigInt
  comment         String?
  photoKey        String?
  idempotencyKey  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    Stage?    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  parent   Payment?  @relation("PaymentParent", fields: [parentPaymentId], references: [id], onDelete: SetNull)
  children Payment[] @relation("PaymentParent")

  @@index([projectId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([parentPaymentId])
  @@index([stageId])
}

// ---------- Materials ----------

model MaterialRequest {
  id             String                @id @default(cuid())
  projectId      String
  stageId        String?
  createdById    String
  recipient      MaterialRecipient
  title          String
  comment        String?
  status         MaterialRequestStatus @default(pending_approval)
  finalizedAt    DateTime?
  deliveredAt    DateTime?
  deliveredById  String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    Stage?            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  items    MaterialItem[]
  disputes MaterialDispute[]

  @@index([projectId, status])
  @@index([stageId])
}

model MaterialItem {
  id           String    @id @default(cuid())
  requestId    String
  name         String
  qty          Decimal   @db.Decimal(12, 3)
  actualQty    Decimal?  @db.Decimal(12, 3)
  unit         String?
  note         String?
  dueDate      DateTime?
  pricePerUnit BigInt?
  totalPrice   BigInt?
  isBought     Boolean   @default(false)
  boughtAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  request MaterialRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  photo   MaterialItemPhoto?

  @@index([requestId])
  @@index([dueDate])
}

model MaterialItemPhoto {
  id          String   @id @default(cuid())
  itemId      String   @unique
  fileKey     String
  thumbKey    String?
  mimeType    String
  sizeBytes   Int
  uploadedBy  String
  exifCleared Boolean  @default(false)
  createdAt   DateTime @default(now())

  item MaterialItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model MaterialDispute {
  id         String    @id @default(cuid())
  requestId  String
  openedById String
  reason     String
  status     String    @default("open")
  resolution String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  request MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
}

// ---------- Expenses (ТЗ NEWFIX §5.1) ----------

/// Расход проекта/этапа: «не привязан к получателю» (в отличие от Payment).
/// Категория (materials/transport/rental/services/other) + опциональное
/// фото чека (photoKey в S3) + автоматическая привязка к этапу (stageId).
model Expense {
  id          String          @id @default(cuid())
  projectId   String
  stageId     String?
  createdById String
  category    ExpenseCategory @default(other)
  name        String
  amount      BigInt
  comment     String?
  /// Фото чека (S3 key, scope=expenses/receipts). Опционально.
  photoKey    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([stageId])
  @@index([category])
}

// ---------- SelfPurchase ----------

model SelfPurchase {
  id              String             @id @default(cuid())
  projectId       String
  stageId         String?
  byUserId        String
  byRole          SelfPurchaseBy
  addresseeId     String
  amount          BigInt
  comment         String?
  photoKeys       String[]           @default([])
  status          SelfPurchaseStatus @default(pending)
  decidedAt       DateTime?
  decidedById     String?
  decisionComment String?
  // 3-tier forwarding: master→foreman→customer. После approve бригадиром
  // создаётся вторая запись (byRole=foreman, addresseeId=ownerId), у которой
  // forwardedFromId указывает на master-оригинал. Связь нужна для UI «спор
  // изначально открыл мастер X», для отчётов и для feed-аналитики.
  forwardedFromId String?
  forwardedFrom   SelfPurchase?      @relation("SelfPurchaseForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedBy     SelfPurchase[]     @relation("SelfPurchaseForward")
  idempotencyKey  String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([addresseeId, status])
  @@index([forwardedFromId])
}

// ---------- Tools ----------
//
// Упрощённая модель (2026-05-12):
//   • Каждый ToolItem — ОДИН физический инструмент (qty=1).
//   • `ownerId` — владелец, чей инструмент. Не меняется.
//   • `currentHolderId` — у кого инструмент сейчас. Меняется только self-claim
//     (пользователь сам отмечает «я взял»). Никто не назначает другого.
//   • `ToolCustodyEvent` — иммутабельный лог передач (история).
//   • `projectId` — если задан, инструмент видим всем участникам проекта.

enum ToolStatus {
  in_storage
  on_project
  with_employee
}

enum ToolCondition {
  new_tool
  good
  worn
  broken
}

model ToolItem {
  id              String   @id @default(cuid())
  ownerId         String
  /// У кого инструмент сейчас. При создании = ownerId. Меняется только через self-claim.
  currentHolderId String
  name            String
  /// Артикул производителя (NEWFIX-2 §7.1) — нужен для общей базы по моделям.
  article         String?
  photoKey        String?
  /// Серийный/инвентарный номер инструмента (опциональный, свободный текст).
  serial          String?
  /// NEWFIX §6.1 — дата покупки. Для предупреждения о гарантии и оценки износа.
  purchaseDate    DateTime?
  /// NEWFIX §6.1 — состояние (new/good/worn/broken). Заполняется владельцем.
  condition       ToolCondition?
  /// NEWFIX-2 §7.1 — формальный статус (in_storage / on_project / with_employee).
  /// Связан с projectId / assignedEmployeeId, но хранится отдельно как явный признак.
  status          ToolStatus @default(in_storage)
  /// Свободный текст: «Склад №1», адрес, «Гараж». Заполняется при status=in_storage.
  storageLocation String?
  /// Если задан — инструмент привязан к проекту и видим всем его участникам.
  /// Если null — инструмент только в личном профиле владельца (My Tools).
  projectId       String?
  /// NEWFIX-2 §9 — инструмент «ездит» с сотрудником. Заполняется при
  /// status=with_employee. При уходе сотрудника из команды FK SET NULL.
  assignedEmployeeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  custodyEvents ToolCustodyEvent[]
  assignedEmployee User? @relation("ToolAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([projectId])
  @@index([currentHolderId])
  @@index([status])
  @@index([assignedEmployeeId])
}

model ToolCustodyEvent {
  id               String   @id @default(cuid())
  toolItemId       String
  /// Контекст проекта на момент события (для history-фильтрации).
  projectId        String
  /// Кто стал держателем. Это всегда == пользователь, инициировавший claim.
  holderId         String
  /// Кто держал до этого (null только для самого первого события — initial-create).
  previousHolderId String?
  /// Опциональная пометка пользователя («забрал на этаж 3»).
  note             String?
  createdAt        DateTime @default(now())

  toolItem ToolItem @relation(fields: [toolItemId], references: [id], onDelete: Cascade)

  @@index([toolItemId, createdAt])
  @@index([projectId, createdAt])
  @@index([holderId])
}

// ---------- Idempotency ----------

model IdempotencyRecord {
