// ---------- S5: Chats ----------

model Chat {
  id                String    @id @default(cuid())
  type              ChatType
  projectId         String?
  stageId           String?
  title             String?
  visibleToCustomer Boolean   @default(false)
  createdById       String
  createdAt         DateTime  @default(now())
