  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, leftAt])
}

model ChatMessage {
  id              String    @id @default(cuid())
  chatId          String
  authorId        String
  text            String?
  attachmentKeys  String[]  @default([])
  forwardedFromId String?
  editedAt        DateTime?
  deletedAt       DateTime?
