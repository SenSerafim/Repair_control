// ---------- S5 Admin Panel (2026-04-22) ----------

enum LegalKind {
  privacy
  tos
  data_processing_consent
}

model LegalDocument {
  id            String    @id @default(cuid())
  kind          LegalKind
  version       Int
  title         String
  bodyMd        String
  publishedAt   DateTime?
  publishedById String?
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, isActive])
  @@index([kind, publishedAt])
}

model LegalAcceptance {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  acceptedAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
}

// ---------- S18: Legal PDF publications (отдельно от LegalDocument с markdown) ----------
// LegalDocument — обязательная markdown-форма для acceptance после логина.
// LegalPublication — опциональные PDF-копии для просмотра/шаринга по публичному
// URL `/legal/public/<slug>`. Один kind может иметь несколько версий, активная
// одна (isActive=true). Slug — стабильный человеко-читаемый идентификатор.
enum LegalPublicationKind {
  privacy_policy
  tos
  data_processing_consent
  other
}

model LegalPublication {
  id            String               @id @default(cuid())
  kind          LegalPublicationKind
  slug          String               @unique
  title         String
  fileKey       String
  mimeType      String
  sizeBytes     Int
  etag          String // sha256(file) для If-None-Match на public stream
  version       Int
  isActive      Boolean              @default(false)
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([kind, isActive])
  @@index([kind, version])
}

// ---------- S18.4: Knowledge Base (категории + статьи + видео/фото/файлы) ----------
// Аналог methodology, но для пользовательских обучающих материалов. Привязка
// к проекту/модулю — через `scope='project_module' + moduleSlug`. FTS-индекс
// searchVector создаётся raw-SQL миграцией (Prisma не управляет GENERATED-колонкой).
enum KnowledgeCategoryScope {
  global
  project_module
}

enum KnowledgeAssetKind {
  image
  video
  file
}

model KnowledgeCategory {
  id          String                 @id @default(cuid())
  title       String
  description String?
  iconKey     String? // имя phosphor-иконки для UI
  scope       KnowledgeCategoryScope @default(global)
  moduleSlug  String? // 'stages'|'approvals'|'finance'|... если scope=project_module
  orderIndex  Int                    @default(0)
  isPublished Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  articles KnowledgeArticle[]

  @@index([scope, orderIndex])
  @@index([moduleSlug])
}

model KnowledgeArticle {
  id          String    @id @default(cuid())
  categoryId  String
  title       String
  body        String    @db.Text
  etag        String // sha256(title+body+sorted asset fileKeys)
  version     Int       @default(1)
  isPublished Boolean   @default(true)
  orderIndex  Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assets   KnowledgeAsset[]

  @@index([categoryId, orderIndex])
}

model KnowledgeAsset {
  id          String             @id @default(cuid())
  articleId   String
  kind        KnowledgeAssetKind
  fileKey     String
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  width       Int?
  height      Int?
  thumbKey    String? // для video — manual upload, ffmpeg отложен
  caption     String?
  orderIndex  Int                @default(0)
  createdAt   DateTime           @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, orderIndex])
}

enum BroadcastStatus {
  draft
  queued
  sent
  failed
}

model BroadcastCampaign {
  id             String          @id @default(cuid())
  title          String
  body           String
  deepLink       String?
  filter         Json            @default("{}")
  createdById    String
  createdAt      DateTime        @default(now())
  sentAt         DateTime?
  targetCount    Int             @default(0)
  queuedCount    Int             @default(0)
  deliveredCount Int             @default(0)
  failedCount    Int             @default(0)
  status         BroadcastStatus @default(draft)

  @@index([createdById, createdAt])
  @@index([status])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model ExportJob {
  id              String       @id @default(cuid())
  projectId       String
  requestedById   String
  kind            ExportKind
  filtersPayload  Json         @default("{}")
  status          ExportStatus @default(queued)
  progressPct     Int          @default(0)
  resultFileKey   String?
  resultSizeBytes Int?
  error           String?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([requestedById, createdAt])
  @@index([expiresAt])
}

