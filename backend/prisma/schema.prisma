generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  customer
  representative
  contractor
  master
  admin
}

enum DevicePlatform {
  ios
  android
}

enum ProjectStatus {
  active
  archived
}

enum StageStatus {
  pending
  active
  paused
  review
  done
  rejected
}

enum PauseReason {
  materials
  approval
  force_majeure
  other
}

enum StepType {
  regular
  extra
}

enum StepStatus {
  pending
  in_progress
  done
  pending_approval
  rejected
}

enum QuestionStatus {
  open
  answered
  closed
}

enum NoteScope {
  personal
  for_me
  stage
  team_broadcast
}

enum NoteKind {
  text
  audio
}

enum TranscriptStatus {
  pending
  done
  failed
}

enum PaymentKind {
  advance
  distribution
  correction
}

enum ExpenseCategory {
  materials
  transport
  rental
  services
  other
}

enum MaterialRequestStatus {
  pending_approval
  open
  bought
  delivered
  accepted_partial
  accepted_full
  disputed
  resolved
  cancelled
}

enum MaterialRecipient {
  foreman
  customer
}

enum SelfPurchaseStatus {
  pending
  approved
  rejected
}

enum SelfPurchaseBy {
  foreman
  master
}

enum ApprovalScope {
  plan
  step
  extra_work
  deadline_change
  stage_accept
  stage_create
  material_purchase
  self_purchase
  defect
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

enum TemplateKind {
  platform
  user
}

enum MembershipRole {
  customer
  representative
  foreman
  master
}

enum InvitationStatus {
  pending
  accepted
  cancelled
  expired
}

enum FeedEventKind {
  project_created
  project_archived
  project_restored
  project_copied
  membership_added
  membership_removed
  stage_created
  stage_started
  stage_paused
  stage_resumed
  stage_sent_to_review
  stage_deadline_recalculated
  stage_deadline_exceeds_project
  stages_reordered
  step_created
  step_updated
  step_completed
  step_uncompleted
  step_deleted
  steps_reordered
  substep_added
  substep_updated
  substep_completed
  substep_uncompleted
  substep_deleted
  photo_attached
  photo_deleted
  extra_work_requested
  note_created
  note_updated
  note_deleted
  question_asked
  question_answered
  question_closed
  progress_recalculated_on_step_change
  approval_requested
  approval_approved
  approval_rejected
  approval_cancelled
  approval_resubmitted
  plan_approved
  deadline_changed
  stage_accepted
  stage_rejected_by_customer
  budget_updated
  methodology_section_created
  methodology_section_updated
  methodology_section_deleted
  methodology_article_created
  methodology_article_updated
  methodology_article_deleted
  payment_created
  payment_distributed
  material_request_created
  material_request_sent
  material_request_approved
  material_request_cancelled
  material_item_bought
  material_request_finalized
  material_delivered
  material_disputed
  material_resolved
  material_request_accepted_partial
  material_request_accepted_full
  material_request_overdue
  selfpurchase_created
  selfpurchase_approved
  selfpurchase_rejected
  selfpurchase_forwarded
  tool_issued
  tool_issuance_confirmed
  tool_return_requested
  tool_returned
