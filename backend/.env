NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repair_control?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev_access_secret_min_16_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_min_16_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

BCRYPT_COST=4

SMS_PROVIDER=stub
SMS_API_KEY=
# Пока SMS-провайдер не подключён — recovery принимает этот код.
# Работает только при SMS_PROVIDER=stub. Меняйте на 1234 / 0000 / любое
# число от 4 до 6 цифр.
SMS_STUB_CODE=123456

# S3 хранилище — Selectel Object Storage (ru-7).
# Консоль: https://my.selectel.ru/storage
# Endpoint: https://s3.ru-7.storage.selcloud.ru
MINIO_ENDPOINT=s3.ru-7.storage.selcloud.ru
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=a3438138b6324c42823b9d7e8ae5f0b5
MINIO_SECRET_KEY=4e486a28aa6f45f0a86c330e193e0238
MINIO_BUCKET=repair-bucket-test
MINIO_PRESIGN_TTL_SECONDS=300
MINIO_REGION=ru-7
MINIO_PATH_STYLE=true

FILE_MAX_SIZE_MB=25
FILE_ALLOWED_MIMES=image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_BLOCK_SECONDS=300

RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BLOCK_SECONDS=300

# Firebase Cloud Messaging — project repaircontrol-22bd3.
# Service Account JSON лежит в backend/secrets/firebase-admin-sdk.json
# (gitignored, permissions 600).
FCM_ENABLED=true
FCM_PROJECT_ID=repaircontrol-22bd3
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@repaircontrol-22bd3.iam.gserviceaccount.com
